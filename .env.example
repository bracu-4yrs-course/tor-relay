# tor-relay dashboard environment variables
# Copy to .env.local (Next.js loads .env.local automatically) and edit as needed.

# Port the Next.js server listens on (defaults to 3000 if unset).
PORT=3000

# Optional shared secret for the proxy endpoint. If unset (and no password
# is configured in the dashboard's Settings tab), the relay is OPEN — no
# auth required.
# PROXY_KEY=

# The proxy password can ALSO be set from inside the dashboard's Settings
# tab — that value is stored in the SQLite database and takes precedence
# over this env var. If both are set, the DB password wins.

# --- Tor supervisor (NO mock mode — every request goes through real Tor) ---

# Path to the tor binary. Defaults to "tor" (looked up via `which`).
# TOR_BIN=/usr/bin/tor

# Tor SOCKS endpoint. Defaults to 127.0.0.1:9050.
# TOR_SOCKS=127.0.0.1:9050

# Tor data directory (tor will write its consensus / descriptors here).
# TOR_DATA=/tmp/tor-relay-data

# --- Database ---

# SQLite database file path. The Setting table stores the in-app password
# hash and dashboard lock state.
DATABASE_URL=file:/home/z/my-project/db/custom.db
